# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo

# local runtime data
/.data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# local tools and generated artifacts
/.codex/
/.lazyweb/
/.product-design/
/outputs/
/work/

# OpenAI Sites / Cloudflare integration is preserved only in the local history.
/.openai/
/.vinext/
/.wrangler/
/dist/
/build/sites-vite-plugin.ts
/vite.config.ts
/worker/
/worker-configuration.d.ts
/examples/d1/
