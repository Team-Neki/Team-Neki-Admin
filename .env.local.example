# Amplitude Dashboard REST API는 Next.js 서버에서 직접 호출합니다.
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
AMPLITUDE_REGION=us
AMPLITUDE_TIME_ZONE=Asia/Seoul
AMPLITUDE_PROJECT_START_DATE=2024-01-01
AMPLITUDE_CACHE_DIR=/app/.data/amplitude

# 운영 CRUD용 관리자 백엔드 기본 주소입니다.
NEKI_ADMIN_API_BASE_URL=

# 금융결제원 오픈뱅킹 연동은 이용기관 승인과 계좌 명의자 동의 후 서버에만 설정합니다.
# GROUP_ACCOUNT_DATA_MODE=mock 로 설정한 개발 환경에서만 화면 검증용 목 데이터를 사용합니다.
GROUP_ACCOUNT_DATA_MODE=live
OPENBANKING_BASE_URL=https://openapi.openbanking.or.kr
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=
OPENBANKING_REDIRECT_URI=
OPENBANKING_SCOPE=login inquiry
OPENBANKING_AUTH_TYPE=0
OPENBANKING_ACCESS_TOKEN=
OPENBANKING_FINTECH_USE_NUM=
OPENBANKING_CLIENT_USE_CODE=
