# Amplitude Dashboard REST API는 Next.js 서버에서 직접 호출합니다.
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
AMPLITUDE_REGION=us
AMPLITUDE_TIME_ZONE=Asia/Seoul
AMPLITUDE_PROJECT_START_DATE=2024-01-01
AMPLITUDE_CACHE_DIR=/app/.data/amplitude

# 운영 CRUD용 관리자 백엔드 기본 주소입니다.
NEKI_ADMIN_API_BASE_URL=

# 로컬 검증 전용: npm run export --prefix collectors/brand-news 로 생성한 JSON의 절대 경로.
# 운영에서는 비워 두면 data/brand-news 브랜치의 공유 JSON을 읽습니다.
BRAND_NEWS_DATA_FILE=

# Google 로그인은 로컬/운영 모두 기본 비활성화. true로 켠 경우 아래 설정이 필수입니다.
ADMIN_AUTH_ENABLED=false
BETTER_AUTH_URL=https://admin-web.suitestudy.com:4641
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 쉼표로 구분한 개별 이메일만 허용. 변경 후 모든 서버 인스턴스를 재시작합니다.
ADMIN_ALLOWED_EMAILS=

# Instagram API with Instagram Login: 서버 전용. NEXT_PUBLIC_ 변수로 만들지 않습니다.
INSTAGRAM_ACCOUNT_ID=17841447544847066
INSTAGRAM_USERNAME=neki_official_
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v26.0
# 기존 Amplitude PVC 안의 하위 경로를 사용합니다. 로컬에서는 비워 두면 /tmp/neki-admin-instagram을 사용합니다.
INSTAGRAM_CACHE_DIR=/app/.data/amplitude/instagram
