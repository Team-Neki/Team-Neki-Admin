# Sprint 프로필에서 발급한 원문 토큰을 입력하세요. 이 예제 파일에는 실제 토큰을 넣지 않습니다.
SPRINT_API_TOKEN=sprint_pat_replace_me

# Amplitude server-side read access. Keep these values out of the browser bundle.
AMPLITUDE_API_KEY=replace_with_amplitude_api_key
AMPLITUDE_SECRET_KEY=replace_with_amplitude_secret_key
# Use "eu" only when the Amplitude project is hosted in the EU region.
AMPLITUDE_REGION=us
# First date from which Amplitude's new-user history should be accumulated for total users.
AMPLITUDE_PROJECT_START_DATE=2024-01-01
# Must match the Amplitude project time zone so completed days finalize at midnight.
AMPLITUDE_TIME_ZONE=Asia/Seoul

# 금융결제원 오픈뱅킹 연동은 이용기관 승인과 계좌 명의자 동의 후 서버에만 설정합니다.
# GROUP_ACCOUNT_DATA_MODE=mock 로 설정한 개발 환경에서만 화면 검증용 목 데이터를 사용합니다.
GROUP_ACCOUNT_DATA_MODE=
OPENBANKING_BASE_URL=
OPENBANKING_ACCESS_TOKEN=
OPENBANKING_FINTECH_USE_NUM=
OPENBANKING_BANK_TRAN_ID=
